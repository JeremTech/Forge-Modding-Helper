<Window x:Class="FMH.Core.View.AssistantCreatorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FMH.Core.View"
        xmlns:controls="clr-namespace:FMH.Core.UI.Controls"
        xmlns:viewModels="clr-namespace:FMH.Core.ViewModel"
        mc:Ignorable="d"
        Height="550"
        Width="650" 
        WindowStartupLocation="CenterScreen" 
        Title="Assistant Creator - Forge Modding Helper" 
        Icon="/FMH.Resources;component/Pictures/icon.png"
        ResizeMode="CanMinimize">

    <Window.DataContext>
        <viewModels:AssistantCreatorViewModel/>
    </Window.DataContext>

    <Grid Background="{DynamicResource PrimaryBackgroundColor}">

        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" 
              Background="{DynamicResource PrimaryBackgroundColor}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Image Grid.Column="0" Height="40" Width="40" HorizontalAlignment="Center" Source="/FMH.Resources;component/Pictures/icon.png"/>
            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock Text="Forge Modding Helper" FontSize="11" Foreground="{DynamicResource FontColorPrimary}"/>
                <TextBlock Text="Assistant Creator" FontSize="17" Margin="0, -5, 0, 0" Foreground="{DynamicResource FontColorPrimary}"/>
            </StackPanel>

        </Grid>

        <!-- Header's border -->
        <Border Grid.Row="1"
                Background="{DynamicResource FontColorSecondary}"/>

        <Frame Grid.Row="2"
               Content="{Binding CurrentAssistantPage, Mode=TwoWay}"/>

        <!-- Bottom bar"s border -->
        <Border Grid.Row="3"
                Background="{DynamicResource FontColorSecondary}"/>

        <!-- Bottom bar -->
        <Grid Grid.Row="4" 
              Background="{DynamicResource SecondaryBackgroundColor}">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0, 0, 5, 0">
                <controls:StandardButton Width="100" Text="Previous" LeftIcon="ArrowLeft" Height="40"/>
                <controls:StandardButton Width="100" Text="Next" RightIcon="ArrowRight" Height="40"/>
            </StackPanel>
        </Grid>

    </Grid>
    
</Window>
