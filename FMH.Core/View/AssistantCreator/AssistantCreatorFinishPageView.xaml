<UserControl x:Class="FMH.Core.View.AssistantCreator.AssistantCreatorFinishPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:local="clr-namespace:FMH.Core.View.AssistantCreator"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800">

    <Grid x:Name="MainGrid"
          Margin="10">

        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- Image -->
            <fa:ImageAwesome x:Name="LoadingSpinner"
                             Grid.Row="2"
                             HorizontalAlignment="Center"
                             Icon="Check"
                             Width="80"
                             Height="80"
                             Margin="0, 5, 0, 0"
                             Foreground="{DynamicResource FontColorPrimary}"/>

            <!-- Finish label -->
            <TextBlock Margin="0, 20, 0, 0"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource FontColorPrimary}"
                       TextWrapping="WrapWithOverflow"
                       Tag="assistant_creator.finish.label.generation_finished"
                       Text="Generation finished !"/>
            <TextBlock Margin="0, 5, 0, 0"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource FontColorPrimary}"
                       TextWrapping="WrapWithOverflow"
                       Tag="assistant_creator.finish.label.click_finish"
                       Text="Click on finish button to close this window"/>

        </StackPanel>

    </Grid>
</UserControl>
