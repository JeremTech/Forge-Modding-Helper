<Page x:Class="FMH.Core.View.AssistantCreator.AssistantCreatorSecondPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:fa="http://schemas.fontawesome.io/icons/"
      xmlns:utils="clr-namespace:FMH.Core.Utils.Converters"
      xmlns:local="clr-namespace:FMH.Core.View.AssistantCreator" 
      xmlns:cm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
      mc:Ignorable="d" 
      d:DesignHeight="433" d:DesignWidth="650"
      Title="Assistant Creator - Step 2">

    <Page.Resources>
        <utils:ApiTypeToApiIconConverter x:Key="ApiTypeToApiIconConverter"/>
    </Page.Resources>
    
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header text -->
        <StackPanel Grid.Row="0" 
                    Orientation="Vertical">

            <TextBlock Tag="assistant_creator.label.versions_page"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource FontColorPrimary}"
                       TextWrapping="WrapWithOverflow"
                       Text="Which version of Minecraft do you want to mod ?"/>

            <TextBlock Tag="assistant_creator.label.versions_page.description"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource FontColorPrimary}"
                       TextWrapping="WrapWithOverflow"
                       Text="Then, you will able to specify the API version."/>

        </StackPanel>
        
        <!-- API version selection -->
        
        <!-- Search area -->
        <Border Grid.Row="1"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderColor}"
                Background="{DynamicResource InputsBackgroundColor}">
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <fa:ImageAwesome Icon="Search"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource FontColorPrimary}"
                                 Margin="4"/>

                <TextBox x:Name="FilterTextBox"
                         Grid.Column="1"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         CaretBrush="{DynamicResource FontColorPrimary}"
                         Foreground="{DynamicResource FontColorPrimary}"
                         TextChanged="FilterTextBox_TextChanged"
                         BorderThickness="0"/>

            </Grid>
        </Border>

        <!-- Loading spinner -->
        <fa:ImageAwesome x:Name="LoadingSpinner"
                         Grid.Row="2"
                         HorizontalAlignment="Center"
                         Icon="CircleOutlineNotch"
                         Visibility="Collapsed"
                         Width="60"
                         Height="60"
                         Spin="True"
                         Margin="0, 5, 0, 0"
                         SpinDuration="1"
                         Panel.ZIndex="1"
                         Foreground="{DynamicResource FontColorPrimary}"/>

        <!-- API versions list -->
        <Border Grid.Row="2"
                BorderThickness="1" 
                BorderBrush="{DynamicResource BorderColor}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="25"/>
                </Grid.RowDefinitions>
                
                <ListView x:Name="APIVersionsListView"
                          Grid.Row="0" 
                          SelectionMode="Single"
                          Background="{DynamicResource InputsBackgroundColor}"
                          BorderBrush="Transparent"
                          ItemsSource="{Binding}"
                          SelectedItem="{Binding DataContext.NewWorkspaceData.ModAPIVersion, RelativeSource={RelativeSource AncestorType=Page}}">

                    <!-- DataContext and sorting -->
                    <ListView.DataContext>
                        <CollectionViewSource Source="{Binding APIVersionsList, RelativeSource={RelativeSource AncestorType=Page}}">
                            <CollectionViewSource.GroupDescriptions>
                                <PropertyGroupDescription PropertyName="MinecraftVersion"/>
                            </CollectionViewSource.GroupDescriptions>
                            <CollectionViewSource.SortDescriptions>
                                <cm:SortDescription PropertyName="MinecraftVersion" Direction="Descending"/>
                            </CollectionViewSource.SortDescriptions>
                        </CollectionViewSource>
                    </ListView.DataContext>

                    <!-- Group styling -->
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Expander IsExpanded="False">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Source="/FMH.Resources;component/Icons/minecraft_icon.png" Width="20" Margin="0, 0, 3, 0"/>
                                                            <TextBlock Text="Minecraft " Foreground="{DynamicResource FontColorPrimary}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource FontColorPrimary}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <ItemsPresenter/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>

                    <!-- Item styling -->
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding ModAPIType, Converter={StaticResource ApiTypeToApiIconConverter}}" Width="20" Margin="0, 0, 5, 0"/>
                                <TextBlock Text="{Binding APIVersion}" Foreground="{DynamicResource FontColorPrimary}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

                <StackPanel Grid.Row="1" Orientation="Horizontal">

                    <TextBlock VerticalAlignment="Center"
                               Margin="4, 0"
                               Text="Current selection :"
                               Foreground="{DynamicResource FontColorPrimary}"/>

                    <TextBlock Grid.Row="1"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource FontColorPrimary}"
                               Text="{Binding DataContext.NewWorkspaceData.ModAPIVersion.APIVersion, RelativeSource={RelativeSource AncestorType=Page}}"/>

                </StackPanel>
                
                
            </Grid>
        </Border>
    </Grid>
</Page>
