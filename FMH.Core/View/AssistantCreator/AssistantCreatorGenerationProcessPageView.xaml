<UserControl x:Class="FMH.Core.View.AssistantCreator.AssistantCreatorGenerationProcessPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:local="clr-namespace:FMH.Core.View.AssistantCreator"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800">
    <Grid>

        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- Spinner -->
            <fa:ImageAwesome x:Name="LoadingSpinner"
                         Grid.Row="2"
                         HorizontalAlignment="Center"
                         Icon="Gear"
                         Width="80"
                         Height="80"
                         Spin="True"
                         Margin="0, 5, 0, 0"
                         SpinDuration="3"
                         Foreground="{DynamicResource FontColorPrimary}"/>

            <!-- Status label -->
            <TextBlock x:Name="StatusLabel"
                       Margin="0, 20, 0, 0"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource FontColorPrimary}"
                       TextWrapping="WrapWithOverflow"
                       Text="{Binding StatusLabelText, RelativeSource={RelativeSource AncestorType={x:Type local:AssistantCreatorGenerationProcessPageView}, Mode=FindAncestor}}"/>

            <!-- Progress bar -->
            <ProgressBar x:Name="ProgressBar"
                         Margin="0, 10, 0, 0"
                         HorizontalAlignment="Center"
                         Width="100"
                         Height="15"
                         Background="Transparent"
                         BorderThickness="0"
                         Visibility="{Binding ProgressBarVisibility, RelativeSource={RelativeSource AncestorType={x:Type local:AssistantCreatorGenerationProcessPageView}, Mode=FindAncestor}}"
                         Value="{Binding ProgressBarValue, RelativeSource={RelativeSource AncestorType={x:Type local:AssistantCreatorGenerationProcessPageView}, Mode=FindAncestor}}"
                         Foreground="{DynamicResource FontColorPrimary}"/>

        </StackPanel>
        
    </Grid>
</UserControl>
